{
  "name": "snap-website",
  "type": "module",
  "version": "0.14.0",
  "description": "API to capture screenshots of websites using Puppeteer",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/snap-website#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/snap-website.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/snap-website/issues"
  },
  "keywords": [
    "puppeteer",
    "node-js",
    "screenshot",
    "website-to-image",
    "website-to-png",
    "website-to-jpeg",
    "website-to-webp",
    "rest-api"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists .env dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test e2e/**/*.test.ts",
    "install:chrome": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@sparticuz/chromium": "^153.0.0",
    "fastify": "^5.12.7",
    "puppeteer-core": "^25.15.0"
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@types/node": "^26.6.5",
    "puppeteer": "^25.15.0",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
